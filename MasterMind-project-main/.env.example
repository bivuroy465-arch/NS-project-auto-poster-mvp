# Copy these into GitLab/GitHub CI/CD variables (Settings > CI/CD > Variables).
# Locally you can copy this file to .env for testing.

# ============================================================
# CREDENTIAL ENCLAVE  (AES-256-GCM BYOK)
# ============================================================
# Generate the master key:
#   python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCLAVE_MASTER_KEY=

# Encrypt each API key with the enclave provisioning helper:
#   python -c "
#   import base64, os
#   from src.enclave import encrypt_credential
#   key = base64.urlsafe_b64decode(os.environ['ENCLAVE_MASTER_KEY'])
#   cred = encrypt_credential('OPENAI_API_KEY', 'sk-...', key)
#   print(cred.to_env_value())
#   "
# Then set ENCRYPTED_<NAME>=<output> in your CI/CD secrets.
ENCRYPTED_OPENAI_API_KEY=
ENCRYPTED_ANTHROPIC_API_KEY=
ENCRYPTED_GEMINI_API_KEY=
ENCRYPTED_GROQ_API_KEY=
ENCRYPTED_STABILITY_API_KEY=
ENCRYPTED_TWITTER_API_KEY=
ENCRYPTED_TWITTER_API_SECRET=
ENCRYPTED_TWITTER_ACCESS_TOKEN=
ENCRYPTED_TWITTER_ACCESS_SECRET=
ENCRYPTED_LINKEDIN_ACCESS_TOKEN=
ENCRYPTED_FACEBOOK_PAGE_ACCESS_TOKEN=

# ============================================================
# EDGE GATEWAY  (JWT auth)
# ============================================================
# Generate a secret:  python -c "import secrets; print(secrets.token_hex(32))"
GATEWAY_JWT_SECRET=
GATEWAY_JWT_ISSUER=autoposter

# ============================================================
# UPSTASH REDIS  (Stream broker + rate limiting + distributed locks)
# ============================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================================
# OPENTELEMETRY  (optional — omit for local dev Console output)
# ============================================================
# OTEL_SERVICE_NAME=autoposter
# OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io

# ============================================================
# TEXT PROVIDERS  (set the one you use in config.yaml)
# ============================================================
# These are only used when NOT using the Credential Enclave.
# In production, use ENCRYPTED_* vars above instead.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ============================================================
# IMAGE PROVIDERS
# ============================================================
STABILITY_API_KEY=

# ============================================================
# TWITTER / X
# ============================================================
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ============================================================
# LINKEDIN
# ============================================================
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# ============================================================
# FACEBOOK PAGE
# ============================================================
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# ============================================================
# GOOGLE SHEETS
# ============================================================
# Paste the full service-account JSON as a single-line value.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# ============================================================
# FAILURE ALERTING  (optional)
# ============================================================
# Telegram: https://api.telegram.org/bot<TOKEN>/sendMessage  (+ TELEGRAM_CHAT_ID)
# Discord:  https://discord.com/api/webhooks/<id>/<token>
# Slack/generic webhooks also work ({"text": ...}).
ALERT_WEBHOOK_URL=
TELEGRAM_CHAT_ID=

# ============================================================
# OPTIONAL
# ============================================================
# LOG_LEVEL=INFO
# DRY_RUN=true   # generate content but do not publish
# APP_VERSION=1.0.0
