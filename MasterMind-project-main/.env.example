# Copy these into GitLab CI/CD variables (Settings > CI/CD > Variables).
# Locally you can copy this file to .env for testing.

# --- Text providers (set the one you use in config.yaml) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Image providers ---
# OPENAI_API_KEY above is reused for DALL-E.
STABILITY_API_KEY=

# --- Twitter / X ---
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# --- LinkedIn ---
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# --- Facebook Page ---
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# --- Google Sheets ---
# Paste the full service-account JSON as a single-line value.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# --- Failure alerting (optional) ---
# Telegram: https://api.telegram.org/bot<TOKEN>/sendMessage  (+ TELEGRAM_CHAT_ID)
# Discord:  https://discord.com/api/webhooks/<id>/<token>
# Slack/generic webhooks also work ({"text": ...}).
ALERT_WEBHOOK_URL=
TELEGRAM_CHAT_ID=

# --- Optional ---
# LOG_LEVEL=INFO
# DRY_RUN=true   # generate content but do not publish
